diff --git a/src/data/DataManager.cpp b/src/data/DataManager.cpp
index 69ba830b..3d273cdb 100644
--- a/src/data/DataManager.cpp
+++ b/src/data/DataManager.cpp
@@ -2125,6 +2125,25 @@ void DataManagerImpl::build_train_schedule_locked() {
     // Interleave step order so full-chunk and mixed steps don't cluster.
     std::shuffle(_train_schedule.begin(), _train_schedule.end(), _rng);
 
+    // Runs of frame_run steps from one frame, the last run of a frame padded with
+    // its first steps so every run starts on a multiple of frame_run.
+    if (_cfg.frame_run > 1 && _cfg.views_per_frame > 0 && B == 1) {
+        const size_t R = (size_t)_cfg.frame_run;
+        std::map<int32_t, std::vector<StepSpec>> by_frame;
+        for (auto& step : _train_schedule)
+            by_frame[step.front().picks.front() / _cfg.views_per_frame].push_back(std::move(step));
+        std::vector<std::vector<StepSpec>> runs;
+        for (auto& [frame, steps] : by_frame)
+            for (size_t i = 0; i < steps.size(); i += R) {
+                runs.emplace_back();
+                for (size_t k = 0; k < R; ++k) runs.back().push_back(steps[(i + k) % steps.size()]);
+            }
+        std::shuffle(runs.begin(), runs.end(), _rng);
+        _train_schedule.clear();
+        for (auto& run : runs)
+            for (auto& step : run) _train_schedule.push_back(std::move(step));
+    }
+
     // One divisor per epoch, so each image trains equally often at each size. An
     // epoch that would cross a stage switch ends at it, which keeps the switch on
     // its planned step after a mid-epoch resume or a pass of uneven length.
